# Quadlet unit for the factory, installed by deploy/install.sh into
# ~/.config/containers/systemd/ of the user that runs it.
[Unit]
Description=factory dashboard and job loop
Requires=podman.socket
After=podman.socket network-online.target

[Container]
Image=localhost/factory:latest
ContainerName=factory
PublishPort=127.0.0.1:8080:8080
SecurityLabelDisable=true
# Workers join this network to reach the MCP proxy by the factory's container
# name. The dashboard is published to the host loopback alone, above, so a
# worker on this network cannot reach it. install.sh creates the network.
Network=factory
# The factory hands host paths to podman when it starts workers, so its data
# directory has the same path inside the container as on the host.
Volume=%h/.local/share/factory:%h/.local/share/factory
Volume=%t/podman/podman.sock:/run/podman/podman.sock
Environment=FACTORY_DATA=%h/.local/share/factory
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Environment=FACTORY_WORKER_VOLUMES=factory-nix:/nix
# The MCP proxy binds every interface so workers on the shared network reach it;
# the dashboard stays on the container loopback. Workers join FACTORY_WORKER_NETWORK
# and reach the proxy at FACTORY_PROXY_URL, the factory's name on that network.
Environment=FACTORY_PROXY_LISTEN=0.0.0.0:8081
Environment=FACTORY_PROXY_URL=http://factory:8081
Environment=FACTORY_WORKER_NETWORK=factory
Environment=RUST_LOG=info
# install.sh adds a Secret=gh-token line here when that podman secret exists.
# The factory reads GH_TOKEN once, to give each existing GitHub project that
# token as its project token, so a new install has no such secret.
# install.sh adds a Secret=claude-token line here when that podman secret
# exists. The factory reads the Claude token from its secret store and imports
# the podman secret on first start, so a fresh install has no such secret, and
# Quadlet refuses to start a unit that names a missing one.
# Encrypts per-project MCP header values at rest. The factory container gets
# it; workers never do, so a stolen worker cannot read a credential.
Secret=factory-master-key,type=env,target=FACTORY_MASTER_KEY

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
