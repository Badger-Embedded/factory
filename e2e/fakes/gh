#!/usr/bin/env bash
# Stands in for the GitHub CLI. The browser tests never reach GitHub.
if [ "$1" = api ]; then
  case "$2" in
    user)
      if [ "$3 $4" != "--hostname github.com" ]; then
        echo "gh: api user must pin the host (got: $*)" >&2
        exit 1
      fi
      case "$GH_TOKEN" in
        tok-e2e-alice)
          echo '{"login":"alice-bot","id":11}'
          exit 0
          ;;
        tok-e2e-bob)
          echo '{"login":"bob-bot","id":22}'
          exit 0
          ;;
        tok-e2e-ghost)
          echo '{"login":"ghost-bot","id":33}'
          exit 0
          ;;
      esac
      echo "gh: Bad credentials (HTTP 401)" >&2
      exit 1
      ;;
    repos/e2e/missing | repos/e2e/missing/*)
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
      ;;
    repos/e2e/good)
      echo '{"permissions":{"admin":false,"push":true},"allow_squash_merge":true,"delete_branch_on_merge":true}'
      exit 0
      ;;
    repos/e2e/good/branches/*)
      echo '{"protected":true}'
      exit 0
      ;;
    repos/e2e/good/actions/workflows)
      echo '{"total_count":1}'
      exit 0
      ;;
    repos/e2e/*/*) ;;
    repos/e2e/*)
      # The account's access to a project's repository, by token: alice-bot
      # has Write, bob-bot has Read and ghost-bot cannot see it.
      case "$GH_TOKEN" in
        tok-e2e-alice)
          echo '{"permissions":{"admin":false,"maintain":false,"push":true}}'
          exit 0
          ;;
        tok-e2e-bob)
          echo '{"permissions":{"admin":false,"maintain":false,"push":false}}'
          exit 0
          ;;
        tok-e2e-ghost)
          echo "gh: Not Found (HTTP 404)" >&2
          exit 1
          ;;
      esac
      ;;
  esac
fi
echo "fake gh: no response is set up for: $*" >&2
exit 1
