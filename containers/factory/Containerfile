# The factory: dashboard, job loop and the gh and git it publishes with.
# It starts workers through the host's podman socket.
FROM docker.io/library/rust:1-trixie AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
RUN cargo build --release --locked -p factory-server

FROM docker.io/library/ubuntu:26.04
ARG GH_VERSION=2.104.0
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git podman-remote \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
       | tar -xz -C /usr/local --strip-components=1 \
    && gh --version \
    && ln -s /usr/bin/podman-remote /usr/local/bin/podman

COPY --from=build /src/target/release/factory-server /usr/local/bin/factory-server

ENV FACTORY_LISTEN=0.0.0.0:8080 \
    FACTORY_WORKERS=podman
EXPOSE 8080
CMD ["factory-server"]
