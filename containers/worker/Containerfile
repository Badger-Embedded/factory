# The worker: Claude Code, Codex, git and nix. It also carries Python and
# common shell tools, so agents don't reach for a nix shell to inspect a binary
# or parse JSON. The factory runs it with --userns=keep-id, so the image user
# has the UID of the host user that runs podman, 1000 on moon.
FROM docker.io/library/ubuntu:26.04

ARG UID=1000
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git unzip xz-utils \
       python3 jq binutils file xxd bsdextrautils less tree fd-find sqlite3 patch make \
       zip bzip2 zstd bc gettext-base lsof iproute2 dnsutils netcat-openbsd rsync shellcheck \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && for c in python3 curl jq strings file xxd hexdump less tree fd \
                sqlite3 patch make zip bzip2 zstd bc envsubst \
                lsof ss ip dig nc rsync shellcheck; do \
         command -v "$c" >/dev/null || { echo "missing: $c" >&2; exit 1; }; \
       done \
    && (userdel --remove ubuntu 2>/dev/null || true) \
    && useradd --create-home --uid "$UID" --shell /bin/bash worker \
    && mkdir -p /nix /work /claude /codex \
    && chown worker:worker /nix /work /claude /codex

# Codex CLI, pinned to one openai/codex release so the stdout parser and the
# docs track a single version. moon is x86_64. The codex-package archive holds
# codex with the helpers it runs from its own directory: codex-code-mode-host,
# which runs Codex's shell and workspace tools, bwrap and rg. The bare codex
# asset lacks them, and without the host every command Codex tries fails.
# The package goes to /opt/codex as released, with codex linked into PATH. The
# build fails if the code-mode host is missing or the installed version does
# not match CODEX_VERSION. /etc/codex/skills/factory points Codex at the
# factory's review skills without the --plugin-dir flag Claude uses; the symlink
# resolves once the agents directory is copied below.
ARG CODEX_VERSION=0.165.0
ARG CODEX_ASSET=codex-package-x86_64-unknown-linux-musl
RUN curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/${CODEX_ASSET}.tar.gz" -o /tmp/codex.tar.gz \
    && mkdir -p /opt/codex \
    && tar -xzf /tmp/codex.tar.gz -C /opt/codex \
    && rm -f /tmp/codex.tar.gz \
    && test -x /opt/codex/bin/codex-code-mode-host \
    && ln -s /opt/codex/bin/codex /usr/local/bin/codex \
    && ver="$(codex --version)" \
    && grep -qw "${CODEX_VERSION}" <<<"$ver" \
    && mkdir -p /etc/codex/skills \
    && ln -s /factory-agents/skills /etc/codex/skills/factory

USER worker
ENV HOME=/home/worker \
    USER=worker \
    PATH=/home/worker/.local/bin:/home/worker/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin

RUN curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon \
    && mkdir -p ~/.config/nix \
    && echo "experimental-features = nix-command flakes" > ~/.config/nix/nix.conf

RUN curl -fsSL https://claude.ai/install.sh | bash \
    && claude --version

# The factory's own skills. A reviewer run loads them with --plugin-dir; the
# reviewed repository's skills still load alongside them.
COPY --chown=worker:worker agents /factory-agents

WORKDIR /work
